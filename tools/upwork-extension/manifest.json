{
  "manifest_version": 3,
  "name": "1AltX Upwork Feed",
  "version": "1.0",
  "description": "Posts new Best Matches jobs to n8n pipeline",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://n8n.dakona.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/find-work/best-matches*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "1AltX Upwork Feed"
  }
}
